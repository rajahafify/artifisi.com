---
// A small voxel map with players walking on it. Each player leaves a dotted
// trail of the positions it passed, the kind of thing Dunia records.
---

<figure class="scene">
  <div class="scene-canvas" id="voxel-scene" aria-hidden="true"></div>
  <figcaption class="small">
    Drawn live in your browser. Each red cube is a player. The dots are where it has been and the rings are
    where it chose a new direction. That trail is the kind of data Dunia records.
  </figcaption>
</figure>

<style>
  .scene { margin: 0 0 28px; }
  .scene-canvas { width: 100%; max-width: 100%; aspect-ratio: 16 / 10; cursor: grab; touch-action: pan-y; }
  .scene-canvas:active { cursor: grabbing; }
  .scene-canvas canvas { display: block; width: 100% !important; height: 100% !important; }
  .scene figcaption { margin-top: 8px; }
</style>

<script>
  import * as THREE from "three";

  const host = document.getElementById("voxel-scene");
  if (host) start(host);

  function start(host: HTMLElement) {
    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    } catch {
      host.closest("figure")?.remove();
      return;
    }
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    host.appendChild(renderer.domElement);

    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0.1, 200);

    scene.add(new THREE.HemisphereLight(0xffffff, 0x445566, 1.6));
    const sun = new THREE.DirectionalLight(0xffffff, 1.8);
    sun.position.set(20, 30, 10);
    scene.add(sun);

    // Island heightmap from a few sine waves and a radial falloff.
    const N = 26;
    const half = N / 2;
    const heights: number[][] = [];
    for (let x = 0; x < N; x++) {
      heights[x] = [];
      for (let z = 0; z < N; z++) {
        const dx = (x - half) / half;
        const dz = (z - half) / half;
        const r = Math.sqrt(dx * dx + dz * dz);
        const n = Math.sin(x * 0.55) * Math.cos(z * 0.45) + 0.6 * Math.sin((x + z) * 0.3);
        heights[x][z] = Math.round(3.2 * (1 - r * 1.15) + n * 1.1);
      }
    }

    const colors = {
      water: new THREE.Color("#3f7fb5"),
      sand: new THREE.Color("#dcc58e"),
      grass: new THREE.Color("#6aa04f"),
      hill: new THREE.Color("#4d7d3c"),
      roof: new THREE.Color("#a5452c"),
      wall: new THREE.Color("#efe6d2"),
    };

    const cells: { x: number; z: number; y: number; color: THREE.Color }[] = [];
    const walkable: boolean[][] = [];
    for (let x = 0; x < N; x++) {
      walkable[x] = [];
      for (let z = 0; z < N; z++) {
        const h = heights[x][z];
        if (h <= 0) {
          cells.push({ x, z, y: 0, color: colors.water });
          walkable[x][z] = false;
          continue;
        }
        for (let y = 1; y <= h; y++) {
          const c = h === 1 ? colors.sand : y === h ? (h >= 4 ? colors.hill : colors.grass) : colors.sand;
          cells.push({ x, z, y, color: c });
        }
        walkable[x][z] = h <= 3;
      }
    }

    // A few houses on flat grass.
    const houses = [
      [10, 9], [11, 9], [15, 12], [9, 14], [13, 16],
    ];
    for (const [x, z] of houses) {
      const h = heights[x]?.[z];
      if (!h || h < 2) continue;
      cells.push({ x, z, y: h + 1, color: colors.wall });
      cells.push({ x, z, y: h + 2, color: colors.roof });
      walkable[x][z] = false;
    }

    const box = new THREE.BoxGeometry(1, 1, 1);
    const mat = new THREE.MeshLambertMaterial();
    const mesh = new THREE.InstancedMesh(box, mat, cells.length);
    const m = new THREE.Matrix4();
    cells.forEach((c, i) => {
      const yScale = c.color === colors.water ? 0.6 : 1;
      m.makeScale(1, yScale, 1);
      m.setPosition(c.x - half, c.y - (c.color === colors.water ? 0.2 : 0), c.z - half);
      mesh.setMatrixAt(i, m);
      mesh.setColorAt(i, c.color);
    });
    scene.add(mesh);

    const top = (x: number, z: number) => Math.max(heights[x][z], 0) + 0.9;

    // Players.
    const linkColor = () => new THREE.Color(getComputedStyle(document.documentElement).getPropertyValue("--link").trim() || "#1a0dab");
    const trailMat = new THREE.PointsMaterial({ size: 3, sizeAttenuation: false, color: linkColor() });
    const ringMat = new THREE.MeshBasicMaterial({ color: linkColor(), side: THREE.DoubleSide });
    const agentMat = new THREE.MeshLambertMaterial({ color: "#d1402a" });
    const TRAIL = 60;

    type Agent = {
      mesh: THREE.Mesh;
      cx: number; cz: number; tx: number; tz: number; t: number;
      trail: THREE.Vector3[];
      points: THREE.Points;
      rings: THREE.Mesh[];
    };

    const spots: [number, number][] = [];
    for (let x = 0; x < N; x++) for (let z = 0; z < N; z++) if (walkable[x][z] && heights[x][z] > 0) spots.push([x, z]);

    const agents: Agent[] = [];
    for (let i = 0; i < 5; i++) {
      const [cx, cz] = spots[Math.floor((i + 1) * spots.length / 6)];
      const a = new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.5, 0.5), agentMat);
      scene.add(a);
      const geo = new THREE.BufferGeometry();
      geo.setAttribute("position", new THREE.BufferAttribute(new Float32Array(TRAIL * 3), 3));
      geo.setDrawRange(0, 0);
      const points = new THREE.Points(geo, trailMat);
      scene.add(points);
      agents.push({ mesh: a, cx, cz, tx: cx, tz: cz, t: 1, trail: [], points, rings: [] });
    }

    const ringGeo = new THREE.RingGeometry(0.25, 0.38, 20);

    function pickNext(a: Agent) {
      const options: [number, number][] = [];
      for (const [dx, dz] of [[1, 0], [-1, 0], [0, 1], [0, -1]]) {
        const nx = a.cx + dx, nz = a.cz + dz;
        if (nx < 0 || nz < 0 || nx >= N || nz >= N) continue;
        if (!walkable[nx][nz] || heights[nx][nz] <= 0) continue;
        if (Math.abs(heights[nx][nz] - heights[a.cx][a.cz]) > 1) continue;
        options.push([nx, nz]);
      }
      if (!options.length) { a.tx = a.cx; a.tz = a.cz; return; }
      // Mostly keep going straight; sometimes turn, and mark the turn.
      const dirX = a.tx - a.cx, dirZ = a.tz - a.cz;
      const straight = options.find(([x, z]) => x - a.cx === dirX && z - a.cz === dirZ && (dirX || dirZ));
      const next = straight && Math.random() < 0.75 ? straight : options[Math.floor(Math.random() * options.length)];
      if (next !== straight) {
        const ring = new THREE.Mesh(ringGeo, ringMat);
        ring.rotation.x = -Math.PI / 2;
        ring.position.set(a.cx - half, top(a.cx, a.cz) - 0.38, a.cz - half);
        scene.add(ring);
        a.rings.push(ring);
        if (a.rings.length > 6) scene.remove(a.rings.shift()!);
      }
      a.tx = next[0];
      a.tz = next[1];
    }

    function step(a: Agent, dt: number) {
      a.t += dt * 2.2;
      if (a.t >= 1) {
        const prevX = a.cx, prevZ = a.cz;
        a.cx = a.tx; a.cz = a.tz; a.t = 0;
        const save = { tx: a.cx + (a.cx - prevX), tz: a.cz + (a.cz - prevZ) };
        a.tx = save.tx; a.tz = save.tz;
        pickNext(a);
        a.trail.push(new THREE.Vector3(a.cx - half, top(a.cx, a.cz) - 0.35, a.cz - half));
        if (a.trail.length > TRAIL) a.trail.shift();
        const attr = a.points.geometry.getAttribute("position") as THREE.BufferAttribute;
        a.trail.forEach((p, i) => attr.setXYZ(i, p.x, p.y, p.z));
        attr.needsUpdate = true;
        a.points.geometry.setDrawRange(0, a.trail.length);
      }
      const x = THREE.MathUtils.lerp(a.cx, a.tx, a.t);
      const z = THREE.MathUtils.lerp(a.cz, a.tz, a.t);
      const y = THREE.MathUtils.lerp(top(a.cx, a.cz), top(a.tx, a.tz), a.t) - 0.15 + Math.sin(a.t * Math.PI) * 0.15;
      a.mesh.position.set(x - half, y, z - half);
    }

    // Camera orbit, with drag to turn.
    let angle = Math.PI / 4;
    let dragging = false;
    let lastX = 0;
    host.addEventListener("pointerdown", (e) => { dragging = true; lastX = e.clientX; });
    window.addEventListener("pointerup", () => { dragging = false; });
    window.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      angle -= (e.clientX - lastX) * 0.008;
      lastX = e.clientX;
      if (reduced) render();
    });

    function placeCamera() {
      const r = 40;
      camera.position.set(Math.cos(angle) * r, 30, Math.sin(angle) * r);
      camera.lookAt(0, 0, 0);
    }

    function resize() {
      const w = host.clientWidth;
      const h = host.clientHeight;
      renderer.setSize(w, h, false);
      const view = 11;
      const aspect = w / h;
      camera.left = -view * aspect;
      camera.right = view * aspect;
      camera.top = view;
      camera.bottom = -view;
      camera.updateProjectionMatrix();
      render();
    }

    function render() {
      placeCamera();
      renderer.render(scene, camera);
    }

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let visible = true;
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; }).observe(host);
    new ResizeObserver(resize).observe(host);

    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
      trailMat.color = linkColor();
      ringMat.color = linkColor();
      render();
    });

    // Warm up so the first frame already has trails on it.
    for (let i = 0; i < 400; i++) agents.forEach((a) => step(a, 1 / 30));
    resize();

    if (reduced) return;
    let last = performance.now();
    function loop(now: number) {
      const dt = Math.min((now - last) / 1000, 0.1);
      last = now;
      if (visible) {
        if (!dragging) angle += dt * 0.08;
        agents.forEach((a) => step(a, dt));
        render();
      }
      requestAnimationFrame(loop);
    }
    requestAnimationFrame(loop);
  }
</script>
