---
// The Dunia page. Built with the scroll-craft skill: live-surface grammar. Below the hero the page is the
// recorder itself, pinned, and the scroll is its playhead. Brief: scrollcraft/builds/artifisi-dunia/BRIEF.md
import Head from "../../components/Head.astro";
import Hero from "../../components/Hero.astro";
import Records from "../../components/Records.astro";
import Ending from "../../components/Ending.astro";
import { duniaVideo, formspree } from "../../data.js";
import "../../styles/home.css";
import "../../styles/scrollcraft.css";
import "../../styles/system.css";
import "../../styles/dunia.css";
import "../../styles/iso.css";
// Fig 1, drawn with the Anatomy kit. Rebuild with: node tools/anatomy/recorder/build.mjs
import recorderFig from "../../figures/recorder.html?raw";

// The six channels the recorder writes on every tick. The readouts are filled by dunia.js from a sample flight.
const channels = [
  { id: "rgb", name: "Camera", what: "What the player saw" },
  { id: "depth", name: "Depth", what: "How far away everything was" },
  { id: "seg", name: "Segmentation", what: "Which thing each pixel belongs to" },
  { id: "imu", name: "Motion", what: "Acceleration and turn rate" },
  { id: "act", name: "Action", what: "What the player did" },
  { id: "gt", name: "Ground truth", what: "Where everything really was" },
];
// Tabs in the window bar. Each one jumps the playhead to its part of the act.
const tabs = [
  { id: "watch", label: "Watch", at: 0 },
  { id: "record", label: "Record", at: 0.14 },
  { id: "export", label: "Export", at: 0.64 },
  { id: "status", label: "Status", at: 0.88 },
];
const arrow = '<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square"/></svg>';
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title="Dunia"
      description="Dunia records gameplay as labelled training data for robots and physical AI: camera, depth, segmentation, motion, actions and ground truth, exported as RLDS episodes."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" /><!-- taste-skill-ignore: mono is for the recorder's readouts, which are telemetry -->
    <script is:inline>document.documentElement.classList.add("js")</script>
  </head>
  <body class="dunia-page">
    <Hero base="/" start="ai" aiHref="#demo" aiNote="Dunia, the recorder below">
      <h1><span class="ln" style="--i:0"><span style="color:inherit">Gameplay in,</span></span> <span class="ln" style="--i:1"><span>training data out.</span></span></h1>
    </Hero>

    <main id="rec">

<!-- The recorder. One pinned act; the scroll is the playhead. -->
<section class="ds" id="demo" data-sc-act="pin" data-sc-span="5.2" aria-labelledby="demo-h">
  <div class="sc-stage ds-stage" data-sc-stage>
    <div class="ds-win" data-phase="watch">
      <header class="ds-bar">
        <h2 id="demo-h" class="ds-name">Dunia</h2>
        <span class="ds-file">sample_flight.rlds</span>
        <nav class="ds-tabs" aria-label="Recorder views">
          {tabs.map((t) => <button type="button" data-tab={t.id} data-at={t.at}>{t.label}</button>)}
        </nav>
        <span class="ds-rec" aria-live="off"><i></i><span class="ds-state">Ready</span></span>
      </header>

      <div class="ds-film">
        <iframe src={duniaVideo.embed} title="Dunia demo video" loading="lazy" allow="autoplay; fullscreen" allowfullscreen></iframe>
      </div>

      <aside class="ds-side">
        <div class="ds-help">
          <div class="ds-note" data-for="watch">
            <h3>What Dunia does</h3>
            <p>Dunia sits inside a game engine. While someone plays, it writes down what the world looked like, what they did and what happened next, as labelled training data for robots and physical AI.</p>
            <p class="ds-hint">The film shows it running. Scroll to record a sample flight.</p>
          </div>
          <div class="ds-note" data-for="record">
            <h3>Why games</h3>
            <p>A robot learns from what it saw, what it did and what happened next. Collecting that with real robots is slow and costly, and sometimes the robot breaks. A game engine already knows all three, so nobody labels anything by hand.</p>
          </div>
          <div class="ds-note" data-for="export">
            <h3>Export</h3>
            <p>Each run comes out as an episode of labelled steps, in RLDS, a format robotics teams already train on.</p>
          </div>
          <div class="ds-note" data-for="status">
            <h3>Where it is today</h3>
            <p>A working capture demo inside our own game: it records ten times a second and exports RLDS. Next is the SDK, so other studios can put Dunia in their games.</p>
            <a class="ds-go" href="#pilot"><span>Become a pilot partner</span><Fragment set:html={arrow} /></a>
          </div>
        </div>
        <ul class="ds-ch" aria-label="Channels recorded on every step">
          {channels.map((c) => (
            <li data-ch={c.id}><b>{c.name}</b><span>{c.what}</span><output data-read={c.id}>-</output></li>
          ))}
        </ul>
      </aside>

      <div class="ds-low">
        <div class="ds-time">
          <span class="ds-clock"><b data-t>00:00.0</b> step <b data-step>0</b> at 10 Hz</span>
          <div class="ds-track" aria-hidden="true"><i class="ds-head"></i></div>
        </div>
        <div class="ds-log" aria-label="Steps written">
          <div class="ds-row ds-hd"><span>Step</span><span>Action</span><span>Outcome</span><span>Reward</span></div>
          <div class="ds-rows"></div>
        </div>
        <pre class="ds-tree" aria-label="The exported episode"></pre>
      </div>

      <footer class="ds-foot">Sample session. The readouts and rows are made up to show the shape of the data. The film is real.</footer>
    </div>
  </div>
</section>

<!-- Fig 1: the same idea as a machine on a bench (Anatomy skill) -->
<section class="ds-fig" id="how" aria-labelledby="how-h">
  <div class="df-copy">
    <h2 id="how-h" data-rise>How it works, as a machine</h2>
    <p data-rise>Ten times a second, Dunia takes a sample of the game. Each sample keeps every channel and the player's action side by side. Steer the stick and watch the tape write it down.</p>
  </div>
  <Fragment set:html={recorderFig} />
</section>

<Records />

<!-- The close: an actual input, in the recorder's idiom. -->
<section class="ds-pilot" id="pilot" aria-labelledby="pilot-h">
  <div class="dp-copy">
    <h2 id="pilot-h" data-rise>Pilot partners</h2>
    <p data-rise>The capture demo works. The SDK gets built with the first teams who use it, so it fits a real problem instead of one we guessed at. We ask for a real task or a real game, and honest feedback.</p>
  </div>
  <form class="dp-form" id="pform" action={formspree} method="POST" novalidate data-rise>
    <fieldset class="dp-who">
      <legend>Who you are</legend>
      <label><input type="radio" name="topic" value="Pilot: AI or robotics team" data-ask="What should the robot learn? Tell us the task and the format you train on." checked /><span>AI or robotics team</span></label>
      <label><input type="radio" name="topic" value="Pilot: game studio" data-ask="Which game, which engine, and roughly how many people play it?" /><span>Game studio</span></label>
    </fieldset>
    <label class="dp-ask" for="pmsg">What should the robot learn? Tell us the task and the format you train on.</label>
    <textarea id="pmsg" name="message" rows="3" required></textarea>
    <div class="dp-send">
      <label for="pemail" class="vh">Your email</label>
      <input id="pemail" name="email" type="email" autocomplete="email" required placeholder="you@company.com" />
      <button type="submit"><span>Apply</span><Fragment set:html={arrow} /></button>
    </div>
    <p class="dp-msg" role="status">We reply from hello@artifisi.com.</p>
  </form>
</section>

    </main>

    <Ending />

    <script is:inline type="module" src="/figures/recorder.js"></script>
    <script is:inline src="/scrollcraft/scrollcraft.js"></script>
    <script is:inline>ScrollCraft.mount(document.getElementById("rec"));</script>
    <script>
      import "../../scripts/hero.js";
      import "../../scripts/site.js";
      import "../../scripts/records.js";
      import "../../scripts/dunia.js";
    </script>
  </body>
</html>
