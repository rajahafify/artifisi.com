---
import Head from "../components/Head.astro";
import Hero from "../components/Hero.astro";
import Showcase from "../components/Showcase.astro";
import Wall from "../components/Wall.astro";
import Ending from "../components/Ending.astro";
import "../styles/home.css";
import "../styles/system.css";
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title="Artifisi"
      description="Artifisi is a technology company in Kuala Lumpur with a games division and an AI division. Dunia turns gameplay into labelled training data for robots and physical AI."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" /><!-- taste-skill-ignore: mono is only for the hero readouts -->
    <script is:inline>document.documentElement.classList.add("js")</script>
  </head>
  <body>
<Hero>
  <h1><span class="ln" style="--i:0"><span style="color:inherit">People play games.</span></span> <span class="ln" style="--i:1"><span>We turn what they do into training data for AI.</span></span></h1>
</Hero>

<main>

<section class="sys sec" id="about" aria-labelledby="about-h">
  <div class="rows">
    <div class="row">
      <dl class="facts" data-rise>
        <div><dt>Founded</dt><dd>2023</dd></div>
        <div><dt>Based in</dt><dd>Kuala Lumpur</dd></div>
        <div><dt>Full time since</dt><dd>January 2025</dd></div>
        <div><dt>Status</dt><dd>Malaysia Digital company</dd></div>
      </dl>
      <div>
        <h2 id="about-h" data-rise>Who we are</h2>
        <p class="lead" data-rise style="margin-top:28px">Artifisi Sdn Bhd is a technology company in Kuala Lumpur. We make our own games, and we build AI on top of what games already know: where everything is, what the player did and what happened next.</p>
      </div>
    </div>
    <div class="row" id="do">
      <p class="word" data-rise>What we do</p>
      <div class="record">
        <div data-rise>
          <h3>Games division</h3>
          <p class="soft" style="font-size:15px;margin-bottom:14px">Our own games, from strategy on PC to roguelikes on mobile.</p>
          <ul>
            <li><span>Melaka 1511</span><span>In development</span></li>
            <li><span>Orbwalker</span><span>Playable</span></li>
            <li><span>Hullpack Hero</span><span>Early development</span></li>
          </ul>
        </div>
        <div data-rise>
          <h3>AI division</h3>
          <p class="soft" style="font-size:15px;margin-bottom:14px">Dunia, our SDK that turns gameplay into labelled training data.</p>
          <ul>
            <li><span>Dunia SDK</span><span>MVP</span></li>
            <li><span>Demo game</span><span>Running</span></li>
            <li><span>Pilot partners</span><span>Looking now</span></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="row">
      <p class="word" data-rise>From the founder</p>
      <div class="note">
        <p class="lead" data-rise>I have spent about twelve years building software. At AirAsia I helped scale an app from about 1,000 users a month to about 1,000 users a second.</p>
        <p class="lead" data-rise>I started Artifisi in 2023 and went full time in January 2025. I built Orbwalker alone, from an empty project to a playable game, in three months. Games are how we learned to ship.</p>
        <p class="sign" data-rise><b>Raja Hafify</b><span class="soft">Founder and CEO</span><a href="https://www.linkedin.com/in/rajahafify/" target="_blank" rel="noopener" aria-label="Raja Hafify on LinkedIn"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg></a></p>
      </div>
    </div>
  </div>
</section>

<section class="sys sec" id="mission" aria-labelledby="mission-h" style="padding-top:0">
  <h2 id="mission-h" data-rise style="font-size:28px">What we stand for</h2>
  <div class="cols">
    <div data-rise>
      <h3>Vision</h3>
      <p data-hint="Robots and AI that learn from people at play, not only from expensive lab time.">Machines that learn from the way people play.</p>
    </div>
    <div data-rise>
      <h3>Mission</h3>
      <p data-hint="The game has to be worth playing first. The data comes from that.">Make games people want to play, and turn that play into data machines can learn from.</p>
    </div>
    <div data-rise>
      <h3>Objectives</h3>
      <ul>
        <li data-hint="Turn-based strategy set in the Melaka Sultanate, PC first.">Release Melaka 1511 on PC.</li>
        <li data-hint="Robotics and AI teams test Dunia data in their own pipelines.">Run the first Dunia pilots.</li>
        <li data-hint="Our games first, then games from other studios.">Put Dunia inside more games.</li>
      </ul>
    </div>
    <p class="hint" aria-hidden="true">Hover a line to read more.</p>
  </div>
</section>

<Showcase
  variant="AI division, an SDK for game engines"
  fact="MVP running in our demo game"
  say="While someone plays, Dunia records what the world looked like, what they did and what happened next. Each step comes out labelled, as training data for robots and physical AI."
  href="/projects/dunia"
  action="More about Dunia"
/>

<Wall />

</main>

<Ending base="" />

<script>
  import "../scripts/home.js";
</script>
  </body>
</html>
