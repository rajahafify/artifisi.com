---
// Home page. Built with the scroll-craft skill: split-stage grammar, games on the left, AI on the right,
// resolved when the divider sweeps away and the Dunia film takes the screen. Brief: scrollcraft/builds/artifisi-home/BRIEF.md
import Head from "../components/Head.astro";
import Hero from "../components/Hero.astro";
import Ending from "../components/Ending.astro";
import { games } from "../games.js";
import { duniaVideo } from "../data.js";
import "../styles/home.css";
import "../styles/scrollcraft.css";
import "../styles/system.css";
import "../styles/split.css";

const arrow = '<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square"/></svg>';
const shots = { "Melaka 1511": "/img/melaka-1511.jpg", "Orbwalker": "/img/orbwalker.jpg", "Hullpack Hero": "/img/hullpack-hero.png" };
// Sample rows for the signature move: one moment from each game, as Dunia would write it down. Made up, and labelled so.
const rows = [
  { game: "Melaka 1511", state: "Turn 14, Pahang undecided", action: "Send Hang Tuah as envoy", outcome: "Pahang allied" },
  { game: "Melaka 1511", state: "Portuguese fleet sighted", action: "Raise the harbour guard", outcome: "Harbour held" },
  { game: "Orbwalker", state: "Enemy attacks in 2 turns", action: "Drag fire orb across row 3", outcome: "Combo x4, enemy down" },
  { game: "Orbwalker", state: "Shop, 40 gold", action: "Buy a relic", outcome: "Fire damage up" },
  { game: "Hullpack Hero", state: "Hull 62%, asteroid ahead", action: "Fire mining laser", outcome: "Ore +3" },
  { game: "Hullpack Hero", state: "Cargo full", action: "Return to station", outcome: "Run banked" },
];
// When each game's rows land, in act progress.
const at = [0.14, 0.22, 0.46, 0.54, 0.78, 0.86];
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title="Artifisi"
      description="Artifisi is a technology company in Kuala Lumpur with a games division and an AI division. Dunia turns gameplay into labelled training data for robots and physical AI."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" /><!-- taste-skill-ignore: mono is only for the hero readouts -->
    <script is:inline>document.documentElement.classList.add("js")</script>
  </head>
  <body class="split-home">
<Hero>
  <h1><span class="ln" style="--i:0"><span style="color:inherit">People play games.</span></span> <span class="ln" style="--i:1"><span>We turn what they do into training data for AI.</span></span></h1>
</Hero>

<main id="split">

<!-- 1 · Who we are. Each half finishes the other's sentence. -->
<section class="sp" id="about" data-sc-act="pin" data-sc-span="3" aria-labelledby="about-h">
  <div class="sc-stage sp-stage" data-sc-stage>
    <h2 id="about-h" class="vh">Who we are</h2>
    <div class="sp-l">
      <p class="sp-big" data-sc-cue="0 0.42 0 0.35">We make games.</p>
      <p class="sp-mid" data-sc-cue="0.48 1 0.3 0">Strategy on PC and roguelikes on mobile, made in Kuala Lumpur.</p>
      <dl class="sp-facts" data-sc-cue="0.6 1 0.3 0"><div><dt>Founded</dt><dd>2023</dd></div><div><dt>Based in</dt><dd>Kuala Lumpur</dd></div></dl>
    </div>
    <div class="sp-r">
      <p class="sp-big" data-sc-cue="0 0.42 0 0.35" data-sc-kinetic="words">We build AI.</p>
      <p class="sp-mid" data-sc-cue="0.54 1 0.3 0">On top of what games already know: where everything is, what the player did and what happened next.</p>
      <dl class="sp-facts" data-sc-cue="0.66 1 0.3 0"><div><dt>Full time since</dt><dd>January 2025</dd></div><div><dt>Status</dt><dd>Malaysia Digital company</dd></div></dl>
    </div>
  </div>
</section>

<!-- 2 · What we stand for. One sentence starts on the games side and ends on the AI side. -->
<section class="sp sp-stand" id="mission" data-sc-act="pin" data-sc-span="4.2" aria-labelledby="mission-h">
  <div class="sc-stage sp-stage" data-sc-stage>
    <h2 id="mission-h" class="sp-tag">What we stand for</h2>
    <div class="sp-l">
      <div class="sp-phase" data-sc-cue="0 0.3 0 0.3"><h3>Vision</h3><p class="sp-big2">Machines that learn</p></div>
      <div class="sp-phase" data-sc-cue="0.34 0.64 0.3 0.3"><h3>Mission</h3><p class="sp-big2">Make games people want to play,</p></div>
      <div class="sp-phase" data-sc-cue="0.68 1 0.3 0"><h3>Objectives</h3><p class="sp-big2">Release Melaka 1511 on PC.</p></div>
    </div>
    <div class="sp-r">
      <div class="sp-phase" data-sc-cue="0 0.32 0 0.3"><p class="sp-big2">from the way people play.</p></div>
      <div class="sp-phase" data-sc-cue="0.38 0.66 0.3 0.3"><p class="sp-big2">and turn that play into data machines can learn from.</p></div>
      <div class="sp-phase" data-sc-cue="0.72 1 0.3 0"><p class="sp-big2">Run the first Dunia pilots with robotics and AI teams.</p></div>
    </div>
    <p class="sp-both" data-sc-cue="0.84 1 0.4 0">And put Dunia inside more games, ours and other studios'.</p>
  </div>
</section>

<!-- 3 · What we do. Each game arrives on the left; its moments cross the divider and land as rows on the right. -->
<section class="sp sp-do" id="games" data-sc-act="pin" data-sc-span="4.8" aria-labelledby="games-h">
  <div class="sc-stage sp-stage" data-sc-stage>
    <div class="sp-l">
      <h2 id="games-h" class="sp-tag">Our games</h2>
      {games.map((g, i) => (
        <article class="sp-game" data-sc-cue={i === 0 ? "0 0.32 0 0.25" : i === 1 ? "0.36 0.64 0.3 0.25" : "0.68 1 0.3 0"}>
          <figure class="sp-shot"><img src={shots[g.name]} alt={g.alt} width="720" height="405" /></figure>
          <h3>{g.name}</h3>
          <p class="sp-kind">{g.kind}, {g.status.toLowerCase()}</p>
          <p>{g.text}</p>
          <p class="sp-links">{g.links.map((l) => l.embed
            ? <a href={l.href} data-embed={l.embed} target="_blank" rel="noopener">{l.label}</a>
            : <a href={l.href} target={l.href.startsWith("/") ? undefined : "_blank"} rel={l.href.startsWith("/") ? undefined : "noopener"}>{l.label}</a>)}<a href="/games">All our games</a></p>
        </article>
      ))}
    </div>
    <div class="sp-r">
      <h3 class="sp-tag">What Dunia writes down</h3>
      <div class="sheet-x" role="table" aria-label="Sample rows Dunia would record from our games">
        <div class="sx-row sx-head" role="row"><span role="columnheader">Game</span><span role="columnheader">State</span><span role="columnheader">Action</span><span role="columnheader">Outcome</span></div>
        {rows.map((r, i) => (
          <div class="sx-row" role="row" data-sc-cue={`${at[i]} 1 ${(0.07 / (1 - at[i])).toFixed(3)} 0`}><span role="cell">{r.game}</span><span role="cell">{r.state}</span><span role="cell">{r.action}</span><span role="cell">{r.outcome}</span></div>
        ))}
      </div>
      <p class="sx-note">Sample rows, made up to show the shape of the data.</p>
    </div>
    <div class="sp-fly" aria-hidden="true">
      {at.map((a, i) => [0, 1, 2].map((k) => <i style={`--a:${(a - 0.1 + k * 0.016).toFixed(3)};--row:${i};--k:${k}`}></i>))}
    </div>
  </div>
</section>

<!-- 4 · Dunia. The divider sweeps off the left edge and the film takes the screen. The peak. -->
<section class="sp sp-dunia" id="ai" data-sc-act="pin" data-sc-span="3.2" aria-labelledby="ai-h">
  <div class="sc-stage sp-stage" data-sc-stage>
    <div class="sp-l">
      <p class="sp-big2 sp-fade">Every game we make is a place to collect data.</p>
    </div>
    <div class="sp-r">
      <div class="dn-top">
        <h2 id="ai-h" class="dn-title">Dunia</h2>
        <p class="dn-lead">It sits inside a game engine. While someone plays, it records what the world looked like, what they did and what happened next, as labelled training data for robots and physical AI.</p>
      </div>
      <div class="dn-film">
        <iframe src={duniaVideo.embed} title="Dunia demo video" loading="lazy" allow="autoplay; fullscreen" allowfullscreen></iframe>
      </div>
      <div class="dn-foot">
        <p><b>Status</b> Working capture demo in our own game. The video shows it.</p>
        <a class="dn-go" href="/projects/dunia"><span>More about Dunia</span><Fragment set:html={arrow} /></a>
      </div>
    </div>
  </div>
</section>

<!-- The divider: the page's chrome while the split holds. Labels both sides and counts the rows that have crossed. -->
<div class="sp-divider" aria-hidden="true">
  <span class="sd-l">Games</span><span class="sd-bar"><i></i></span><span class="sd-r">AI</span>
  <span class="sd-count"><b>0</b> rows crossed</span>
</div>

<!-- 5 · From the founder. Quiet after the peak. -->
<section class="sys founder" aria-labelledby="founder-h">
  <h2 id="founder-h" class="vh">From the founder</h2>
  <blockquote>
    <p class="q" data-rise>I built Orbwalker alone, from an empty project to a playable game, in three months. Games are how we learned to ship.</p>
    <p class="q-more" data-rise>About twelve years building software. At AirAsia I helped scale an app from about 1,000 users a month to about 1,000 users a second. I started Artifisi in 2023 and went full time in January 2025.</p>
    <footer class="sign" data-rise><b>Raja Hafify</b><span class="soft">Founder and CEO</span><a href="https://www.linkedin.com/in/rajahafify/" target="_blank" rel="noopener" aria-label="Raja Hafify on LinkedIn"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg></a></footer>
  </blockquote>
</section>

</main>

<Ending base="" />

<script is:inline src="/scrollcraft/scrollcraft.js"></script>
<script is:inline>ScrollCraft.mount(document.getElementById("split"));</script>
<script>
  import "../scripts/home.js";
</script>
  </body>
</html>
