---
import Base from "../layouts/Base.astro";

const app = "https://sidekick.artifisi.com";

// The story told by the room scene, one chapter per phase (see PHASES in room.ts).
const chapters = [
  {
    n: "01",
    title: "Check in from your seat.",
    body: "Check in to the event, or to a place like a coworking space. You stay in the talk.",
  },
  {
    n: "02",
    title: "Your sidekick scouts the floor.",
    body: "It reads what each person checked in is looking for and what they can offer.",
  },
  {
    n: "03",
    title: "It ranks who is worth meeting.",
    body: "You get a short list, each with a one-line reason. Read how the two sidekicks would talk, then connect or pass.",
  },
  {
    n: "04",
    title: "Both connect. It's a match.",
    body: "You swap contact details and get an opener for the break. Nobody ever sees a pass.",
  },
];

// Demo people from the Sidekick dev seed. The reasons follow the app's own wording.
const picks = [
  { name: "Daniel Tan", role: "CTO, logistics startup", reason: "Daniel offers engineering help, which you're looking for." },
  { name: "Aisha Rahman", role: "Partner at a seed fund", reason: "Aisha offers funding, which you're looking for." },
  { name: "Mei Lin", role: "Product designer", reason: "Mei offers product feedback, which you're looking for." },
];

// Example conversations for the demo card. Written from the demo profiles, not from a live event.
const talks = [
  {
    id: "daniel",
    name: "Daniel Tan",
    role: "CTO, logistics startup",
    offers: ["Engineering help", "Mentorship"],
    wants: ["Design help", "Hiring"],
    lines: [
      ["mine", "I'm with Hana, a founder. She's looking for funding and engineering help."],
      ["theirs", "I'm with Daniel, CTO at a logistics startup. He can offer engineering help and mentorship, and he's hiring."],
      ["mine", "Hana needs a second pair of eyes on her first release. Worth ten minutes at the break."],
    ],
  },
  {
    id: "aisha",
    name: "Aisha Rahman",
    role: "Partner at a seed fund",
    offers: ["Funding", "Advice", "Intros"],
    wants: ["Customers", "Cofounder"],
    lines: [
      ["mine", "I'm with Hana, a founder raising her first round."],
      ["theirs", "I'm with Aisha, partner at a seed fund. She's meeting founders who already have customers."],
      ["mine", "Hana has a pilot running with two customers. They should talk."],
    ],
  },
  {
    id: "mei",
    name: "Mei Lin",
    role: "Product designer",
    offers: ["Design help", "Product feedback"],
    wants: ["A new role", "Collaborators"],
    lines: [
      ["mine", "I'm with Hana. She wants product feedback before launch."],
      ["theirs", "I'm with Mei, a product designer. She's looking for collaborators."],
      ["mine", "A short review could turn into a project. A good fit for both."],
    ],
  },
];

const rules = [
  ["A pass is private.", "No one can see who you passed on, or who passed on them."],
  ["Contacts after a match.", "Your contact details are shared only when both of you connect."],
  ["Your profile is yours.", "Other people see your card at that event, never your account."],
  ["Blocks go both ways.", "Block someone and neither of you sees the other again."],
];

const faqs = [
  [
    "Do I need an account?",
    "No. As a guest you can fill in a profile, check in and see who your sidekick picks. To connect with people you sign in with Google, and everything you did as a guest carries over.",
  ],
  ["Does it work on my phone?", "Yes. It runs in the browser on any phone or computer, and there is also an Android app that uses the same account."],
  ["Can someone see that I passed?", "No. A pass is never shown to anyone. Only two connects make a match."],
  [
    "How does it decide who to show me?",
    "It compares what you're looking for and can offer with everyone else checked in to the same event, and ranks people by how well you fit both ways.",
  ],
  [
    "Has it been used at a real event?",
    "Not yet. Sidekick is in pilot and has been tested on a demo event. During the pilot, check-in doesn't confirm where you are.",
  ],
];
---

<Base
  title="Sidekick: stay in the talk, meet the right people"
  description="Check in to an event and your sidekick scouts the room, ranks who is worth meeting, and lines up the match. You stay in the talk."
>
  <a class="skip" href="#main">Skip to content</a>

  <header class="nav" data-nav>
    <a class="brand" href="/" aria-label="Sidekick home">
      <span class="brand-dot" aria-hidden="true"></span>Sidekick
    </a>
    <nav aria-label="Main">
      <a href="#story-1">How it works</a>
      <a href="#demo">Try a card</a>
      <a href="#privacy">Privacy</a>
      <a class="nav-cta" href={app}>Open the app <span aria-hidden="true">→</span></a>
    </nav>
  </header>

  <main id="main">
    <!-- The story: a pinned stage with the room scene. Without JavaScript it is a hero plus a list. -->
    <section class="story" id="story" data-story aria-label="How Sidekick works">
      <div class="stage" data-stage>
        <canvas class="room" data-room aria-hidden="true"></canvas>
        <div class="scrim" aria-hidden="true"></div>

        <div class="tags" aria-hidden="true">
          <span class="tag tag-you" data-label-you><i></i>You, in the talk</span>
          <span class="tag tag-sk" data-label-sidekick><i></i>Your sidekick</span>
          {
            picks.map((p, i) => (
              <span class="pick" data-label-pick>
                <span class="pick-card">
                  <b>
                    <em>{i + 1}</em>
                    {p.name}
                  </b>
                  <small>{p.role}</small>
                  <span class="pick-reason">{p.reason}</span>
                  <span class="pick-match">Match. Contacts swapped.</span>
                </span>
              </span>
            ))
          }
        </div>

        <div class="hero" data-hero>
          <p class="kicker"><span class="pulse" aria-hidden="true"></span>For people who go to events to meet people</p>
          <h1>
            <span class="line"><span>Stay in the <em>talk.</em></span></span>
            <span class="line"><span>Your sidekick</span></span>
            <span class="line"><span><em>works the room.</em></span></span>
          </h1>
          <div class="hero-foot">
            <p class="hero-lead">
              Check in, and Sidekick finds the people worth meeting while you listen. You decide who to connect with.
            </p>
            <div class="actions">
              <a class="btn btn-signal" href={app}>Open Sidekick <span aria-hidden="true">→</span></a>
              <a class="btn btn-line" href="#story-1">See how it works</a>
            </div>
          </div>
          <p class="scroll-cue" aria-hidden="true"><span></span>Scroll to watch your sidekick work</p>
        </div>

        <ol class="chapters" data-chapters>
          {
            chapters.map((c, i) => (
              <li class="chapter" id={`story-${i + 1}`} data-chapter>
                <span class="chapter-n">
                  {c.n}
                  <span> / 04</span>
                </span>
                <h2>{c.title}</h2>
                <p>{c.body}</p>
              </li>
            ))
          }
        </ol>

        <div class="rail" data-rail aria-label="Story steps" role="group">
          {
            chapters.map((c, i) => (
              <button type="button" data-step={i} aria-label={`Step ${c.n}: ${c.title}`}>
                <span class="rail-bar"><span /></span>
                <span class="rail-n">{c.n}</span>
              </button>
            ))
          }
        </div>

        <p class="legend" aria-hidden="true">
          <span><i class="lg-you"></i>You</span>
          <span><i class="lg-sk"></i>Your sidekick</span>
          <span><i class="lg-ppl"></i>People at the event</span>
        </p>
      </div>
    </section>

    <!-- Try a card: a working demo of the swipe, with the sidekicks' conversation. -->
    <section class="demo light" id="demo" aria-labelledby="demo-title">
      <div class="wrap demo-grid">
        <div class="demo-copy">
          <p class="eyebrow" data-reveal>Before you swipe</p>
          <h2 id="demo-title" class="display" data-reveal>
            Hear what the two sidekicks <em>would say.</em>
          </h2>
          <p class="body" data-reveal>
            Every card can play the conversation your sidekick would have with theirs. It is made from the two profiles only,
            so it never gives away who has swiped on whom. Try it.
          </p>
          <div class="who" role="tablist" aria-label="Choose a person" data-reveal>
            {
              talks.map((t, i) => (
                <button
                  type="button"
                  role="tab"
                  id={`tab-${t.id}`}
                  aria-controls="demo-card"
                  aria-selected={i === 0 ? "true" : "false"}
                  tabindex={i === 0 ? 0 : -1}
                  data-talk={t.id}
                >
                  <span class="who-av">{t.name[0]}</span>
                  <span class="who-t">
                    <b>{t.name}</b>
                    <small>{t.role}</small>
                  </span>
                </button>
              ))
            }
          </div>
          <p class="fine" data-reveal>Example conversations, written from the demo event's profiles.</p>
        </div>

        <div class="device" data-reveal>
          <div class="card" id="demo-card" role="tabpanel" data-card>
            {
              talks.map((t, i) => (
                <div class="card-body" data-talk-panel={t.id} hidden={i !== 0}>
                  <div class="card-head">
                    <span class="card-av">{t.name[0]}</span>
                    <div>
                      <h3>{t.name}</h3>
                      <p>{t.role}</p>
                    </div>
                    <span class="card-chip">Ranked #{i + 1}</span>
                  </div>
                  <dl class="card-fit">
                    <div>
                      <dt>Can offer</dt>
                      <dd>
                        {t.offers.map((o) => (
                          <span>{o}</span>
                        ))}
                      </dd>
                    </div>
                    <div>
                      <dt>Looking for</dt>
                      <dd>
                        {t.wants.map((o) => (
                          <span>{o}</span>
                        ))}
                      </dd>
                    </div>
                  </dl>
                  <div class="convo" data-convo>
                    {t.lines.map(([who, text]) => (
                      <p class={`msg ${who}`}>
                        <small>{who === "mine" ? "Your sidekick" : `${t.name.split(" ")[0]}'s sidekick`}</small>
                        {text}
                      </p>
                    ))}
                  </div>
                </div>
              ))
            }
            <div class="card-actions">
              <button type="button" class="act act-pass" data-act="pass">Pass</button>
              <button type="button" class="act act-connect" data-act="connect">Connect</button>
            </div>
            <p class="card-result" data-result role="status" aria-live="polite"></p>
          </div>
        </div>
      </div>
    </section>

    <!-- Privacy -->
    <section class="privacy dark" id="privacy" aria-labelledby="privacy-title">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Privacy, by design</p>
        <h2 id="privacy-title" class="display xl" data-reveal>A pass is <em>never</em> seen.</h2>
        <ol class="rules">
          {
            rules.map(([t, b], i) => (
              <li data-reveal>
                <span class="rule-n">0{i + 1}</span>
                <h3>{t}</h3>
                <p>{b}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Questions -->
    <section class="faq light" id="questions" aria-labelledby="faq-title">
      <div class="wrap faq-grid">
        <div>
          <p class="eyebrow" data-reveal>Questions</p>
          <h2 id="faq-title" class="display" data-reveal>Before you <em>check in.</em></h2>
        </div>
        <div class="faq-list" data-reveal>
          {
            faqs.map(([q, a], i) => (
              <details open={i === 0}>
                <summary>
                  {q}
                  <span class="plus" aria-hidden="true" />
                </summary>
                <p>{a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Final call -->
    <section class="final dark" aria-labelledby="final-title">
      <div class="wrap">
        <h2 id="final-title" class="display mega" data-reveal>
          Go to the <em>talk.</em><br />We'll work the room.
        </h2>
        <div class="final-foot" data-reveal>
          <a class="btn btn-signal btn-lg" href={app}>Open Sidekick <span aria-hidden="true">→</span></a>
          <p>Runs in your browser. Look around as a guest, and sign in only when you want to connect.</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot dark">
    <div class="wrap">
      <span class="brand"><span class="brand-dot" aria-hidden="true"></span>Sidekick</span>
      <span>Made by Artifisi Sdn Bhd. In pilot.</span>
      <a href={app}>sidekick.artifisi.com</a>
    </div>
  </footer>
</Base>
